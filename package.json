{
  "name": "magpie",
  "version": "0.43.0",
  "description": "Instagram and X bookmarks and likes in one fast visual library",
  "author": "BeeeFX",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/BeeeFX/Magpie",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeeeFX/Magpie.git"
  },
  "bugs": "https://github.com/BeeeFX/Magpie/issues",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "preview:web": "tsx --tsconfig tsconfig.node.json scripts/preview-renderer.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify": "npm run typecheck && npm run check:hooks && npm run check:notices && npm run check:a11y && npm run check:i18n && npm run check:messages && npm run check:query && npm run check:paging && npm run check:layout && npm run check:boundaries && npm run check:models && npm run check:search && npm run check:schema && npm run check:cache-budget && npm run check:library-guard && npm run check:organizer && npm run check:media && npm run check:embeddings && npm run check:islands && npm run check:map-density && npm run check:map-links && npm run check:map-pan && npm run check:map-levels && npm run build && npm run check:map",
    "fixture": "tsx scripts/make-fixture.ts",
    "check:layout": "tsx scripts/check-layout.ts",
    "check:i18n": "tsx --tsconfig tsconfig.node.json scripts/check-i18n.ts",
    "check:organizer": "tsx --tsconfig tsconfig.node.json scripts/check-organizer.ts",
    "check:media": "tsx --tsconfig tsconfig.node.json scripts/check-media.ts",
    "check:cache-budget": "tsx --tsconfig tsconfig.node.json scripts/check-cache-budget.mts",
    "check:embeddings": "tsx --tsconfig tsconfig.node.json scripts/check-embeddings.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "check:db": "tsx scripts/check-db.ts",
    "check:schema": "tsx --tsconfig tsconfig.node.json scripts/check-schema.ts",
    "check:library-guard": "tsx --tsconfig tsconfig.node.json scripts/check-library-guard.mts",
    "logo": "tsx scripts/make-logo.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "check:vision": "tsx --tsconfig tsconfig.node.json scripts/check-vision.ts",
    "check:map": "tsx --tsconfig tsconfig.node.json scripts/check-map.ts",
    "bench:phrases": "tsx --tsconfig tsconfig.node.json scripts/bench-phrases.mts",
    "bench:vision-topics": "tsx --tsconfig tsconfig.node.json scripts/bench-vision-topics.mts",
    "bench:recipes": "tsx --tsconfig tsconfig.node.json scripts/bench-recipes.mts",
    "bench:map-zoom": "tsx --tsconfig tsconfig.web.json scripts/bench-map-zoom.mts",
    "bench:map-islands": "tsx --tsconfig tsconfig.node.json scripts/bench-map-islands.mts",
    "bench:map-style": "tsx --tsconfig tsconfig.node.json scripts/bench-map-style.mts",
    "check:boundaries": "tsx --tsconfig tsconfig.node.json scripts/check-boundaries.ts",
    "check:map-density": "tsx scripts/check-map-density.ts",
    "check:transcribe": "tsx --tsconfig tsconfig.node.json scripts/check-transcribe.ts",
    "check:inference": "electron scripts/check-inference.cjs",
    "check:hooks": "tsx --tsconfig tsconfig.node.json scripts/check-hooks.ts",
    "check:notices": "tsx --tsconfig tsconfig.node.json scripts/check-notices.ts",
    "check:search": "tsx --tsconfig tsconfig.node.json scripts/check-search.ts",
    "check:query": "tsx --tsconfig tsconfig.node.json scripts/check-query.ts",
    "check:paging": "tsx --tsconfig tsconfig.node.json scripts/check-paging.ts",
    "check:a11y": "tsx --tsconfig tsconfig.node.json scripts/check-a11y.ts",
    "bench:map-quality": "tsx --tsconfig tsconfig.node.json scripts/bench-map-quality.mts",
    "map:compare": "tsx --tsconfig tsconfig.node.json scripts/map-compare.mts",
    "bench:map-regions": "tsx --tsconfig tsconfig.node.json scripts/bench-map-regions.mts",
    "bench:map-grid": "tsx --tsconfig tsconfig.node.json scripts/bench-map-grid.mts",
    "check:islands": "tsx --tsconfig tsconfig.node.json scripts/check-islands.ts",
    "check:map-links": "tsx --tsconfig tsconfig.node.json scripts/check-map-links.ts",
    "check:map-pan": "tsx --tsconfig tsconfig.node.json scripts/check-map-pan.ts",
    "check:map-levels": "tsx --tsconfig tsconfig.node.json scripts/check-map-levels.ts",
    "map:regions": "tsx --tsconfig tsconfig.node.json scripts/map-regions-preview.mts",
    "check:messages": "tsx scripts/check-messages.ts",
    "check:ci": "tsx scripts/check-ci.ts",
    "check:models": "tsx --tsconfig tsconfig.node.json scripts/check-models.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.5",
    "umap-js": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
